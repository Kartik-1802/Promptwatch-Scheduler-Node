generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  role         String    // viewer | editor | admin | super-admin
  passwordSalt String
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  createdBy    String?
  lastLoginAt  DateTime?
  sessions     Session[]
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  role      String
  expiresAt DateTime
}

model Settings {
  id               Int       @id @default(1)
  apiKey           String?
  timezone         String    @default("Asia/Kolkata")
  tickSeconds      Int       @default(60)
  schedulerEnabled Boolean   @default(true)
  lastSyncAt       DateTime?
}

model Project {
  id        String    @id
  name      String
  slug      String?
  website   String?
  createdAt DateTime?
}

model Monitor {
  id                String    @id
  projectId         String
  projectName       String
  name              String
  description       String?
  active            Boolean
  models            String    @default("[]") // JSON-encoded string[] — see src/lib/json.ts
  languageCode      String?
  countryCode       String?
  promptFrequency   String?
  promptCount       Int?
  responseCount     Int?
  averageVisibility Float?
  updatedAt         DateTime?
  seenAt            DateTime?
  nextRetryAt       DateTime?
  staleSince        DateTime?
  scheduleBlocks    ScheduleBlock[]
}

// A monitor can have several of these — each is a single (startDay,startTime)
// to (endDay,endTime) window within the week (0=Mon..6=Sun), sent ON when it
// opens and OFF when it closes. Blocks belonging to the same monitor may
// never overlap or touch (enforced in src/lib/scheduler.ts's blocksOverlap,
// checked by every route that creates or edits a block) so a given moment
// always maps to at most one block, keeping "should this monitor be on right
// now" unambiguous.
model ScheduleBlock {
  id        String   @id @default(cuid())
  monitorId String
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  startDay  Int      // 0=Mon..6=Sun
  startTime String
  endDay    Int      // 0=Mon..6=Sun
  endTime   String
  createdAt DateTime @default(now())

  @@index([monitorId])
}

model LogEntry {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  level     String
  event     String
  message   String
  user      String?
  kind      String?
  monitorId String?
  projectId String?
  code      String?

  @@index([ts])
}

model ApiCallLog {
  id     String   @id @default(cuid())
  ts     DateTime @default(now())
  method String
  path   String
  status Int
  ms     Int
  error  String?

  @@index([ts])
}
