# Copy this to .env and fill in real values before running.
#
# For local (non-Docker) dev: run `docker compose up db` to start just the
# Postgres container, then point DATABASE_URL at localhost as shown below.
# Inside `docker compose up`, the app/worker services override this to
# point at the `db` service instead — see docker-compose.yml.
DATABASE_URL="postgresql://promptwatch:promptwatch@localhost:5432/promptwatch?schema=public"
SUPER_ADMIN_EMAIL=kartik@contentninja.in
SUPER_ADMIN_PASSWORD=2effce3
PROMPTWATCH_BASE_URL=https://server.promptwatch.com/api/v2
